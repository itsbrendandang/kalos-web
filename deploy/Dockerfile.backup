# Tiny sidecar for online backup / encryption / restore drills of the auth
# SQLite database (sqlite3 CLI, age, openssl). All free; nothing is added to
# the app image. Runs as the same uid as the app (10001) so it can read the
# 0600 database files on the /data volume.
#   docker build -t kalos-auth-backup:local -f deploy/Dockerfile.backup deploy
FROM alpine:3.22
RUN apk add --no-cache sqlite age openssl
RUN addgroup -S -g 10001 kalos && adduser -S -D -H -u 10001 -G kalos kalos
USER 10001:10001
WORKDIR /backup
