{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalos",
  "version": "0.1.0",
  "identifier": "bio.kalos.desktop",
  "build": { "frontendDist": "../splash" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kalos",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "resources": ["resources/web/"]
  }
}
