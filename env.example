# Copy the variables you need into .env.local (gitignored) for local
# development. This file is named without a leading dot because this repo's
# environment blocks writes to any .env* path outright (a blanket
# secret-protection rule) - it is otherwise the standard "env.example"
# convention: placeholders only, safe to commit, no real values.
#
# See app/api/engine/[...path]/route.ts and lib/api.ts for how these are used.

# --- Server-only: read by app/api/engine/[...path]/route.ts -----------------
# Never prefix these with NEXT_PUBLIC_. That would ship them to the browser
# bundle, which defeats the entire point of the proxy: a bearer token in any
# client-visible code is public the moment it ships.

# Base URL of the kalos engine (FastAPI portal) this server forwards to.
KALOS_ENGINE_URL=http://127.0.0.1:8050

# Bearer token the proxy attaches as `Authorization: Bearer <token>` on every
# forwarded request. Required once the engine enforces auth (see
# kalos/kalos/portal/auth.py - KALOS_AUTH_TOKENS[_FILE] configured on the
# engine): without it the proxy answers 500 "Kalos engine requires
# authentication". The value below is a PLACEHOLDER - use the plaintext token
# whose SHA-256 you put in the engine's token config, e.g. generate one with
#   openssl rand -hex 32
# Leave it out (or empty) only while the engine is running open.
# KALOS_ENGINE_TOKEN=<token from the engine operator>

# --- Client-visible escape hatches -------------------------------------------
# Leave both unset in normal/deployed use.

# Points the browser straight at an engine, bypassing the /api/engine proxy
# entirely. Only for local dev against an engine with no auth configured -
# never set this in a deployment that has KALOS_ENGINE_TOKEN configured, since
# it routes around the proxy that keeps that token off the client.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8050

# Set to "true" to preview demo/mock data on boards with no live engine data.
# NEXT_PUBLIC_DEMO_MODE=true
