# Copy the variables you need into .env.local (gitignored) for local
# development. This file is named without a leading dot because this repo's
# environment blocks writes to any .env* path outright (a blanket
# secret-protection rule) - it is otherwise the standard "env.example"
# convention: placeholders only, safe to commit, no real values.
#
# See app/api/engine/[...path]/route.ts and lib/api.ts for how these are used.

# --- Server-only: read by app/api/engine/[...path]/route.ts -----------------
# Never prefix these with NEXT_PUBLIC_. That would ship them to the browser
# bundle, which defeats the entire point of the proxy: a bearer token in any
# client-visible code is public the moment it ships.

# Base URL of the kalos engine (FastAPI portal) this server forwards to.
KALOS_ENGINE_URL=http://127.0.0.1:8050

# Bearer token the proxy attaches as `Authorization: Bearer <token>` on every
# forwarded request. Required once the engine enforces auth (see
# kalos/kalos/portal/auth.py - KALOS_AUTH_TOKENS[_FILE] configured on the
# engine); leave unset while the engine is running open.
KALOS_ENGINE_TOKEN=

# --- Authentication (Better Auth, self-hosted; docs/AUTH.md) ---------------
# PLACEHOLDERS ONLY. In production instrumentation.ts refuses to start (exit 1)
# when any of BETTER_AUTH_SECRET, BETTER_AUTH_URL, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, KALOS_ENGINE_JWT_PRIVATE_KEY_FILE, KALOS_ENGINE_JWT_KID
# is missing or still holds one of these placeholder values.

# Signs/encrypts sessions, OAuth state and stored TOTP secrets. >= 32 random
# chars: `openssl rand -base64 32`. One per environment; rotating it signs
# everyone out and makes enrolled TOTP secrets unreadable (docs/AUTH.md).
BETTER_AUTH_SECRET=change-me
# Public origin of this app (no path). OAuth redirect URI is
# <BETTER_AUTH_URL>/api/auth/callback/google. http:// only for localhost.
BETTER_AUTH_URL=http://localhost:3000
# Origin used in printed invitation links (scripts/create-org.mjs); normally
# the same as BETTER_AUTH_URL.
KALOS_PUBLIC_URL=http://localhost:3000

# Google OAuth client ("Web application") - free, see docs/AUTH.md for the
# Google Cloud console steps. Scopes are fixed to: openid email profile.
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# SQLite database for users/sessions/orgs/TOTP. In the image: /data/auth.db on
# a mounted volume (single web replica). Default: ./data/auth.db (gitignored).
# AUTH_DB_PATH=/data/auth.db
# Run schema migrations at start: 1 = migrate then serve, only = migrate and
# exit, sql = print SQL and exit. Leave unset for normal starts.
# AUTH_MIGRATE=only

# Reverse proxy in front of the app (rate limiting + session IPs). Comma-
# separated IPs/CIDRs of YOUR proxy only, and the header it sets. Without
# trusted proxies only a single-value header is trusted - make sure the proxy
# overwrites (not appends to) it. Example: AUTH_TRUSTED_PROXIES=10.0.0.5
# AUTH_TRUSTED_PROXIES=
# AUTH_IP_ADDRESS_HEADERS=x-forwarded-for

# --- Tenants and engine tokens (lib/server/tenants.ts, engine-token.ts) -----
# JSON object { "<organization id>": "<engine tenant id>" }. Written by
# scripts/create-org.mjs; existing entries are never renamed.
KALOS_TENANT_MAP_FILE=/path/to/tenants.json
# Ed25519 PKCS#8 PEM private key FILE (never the key itself in env) and its
# key id; one pair per environment. The engine gets the public key.
KALOS_ENGINE_JWT_PRIVATE_KEY_FILE=/path/to/engine-jwt-ed25519.pem
KALOS_ENGINE_JWT_KID=change-me

# --- Client-visible escape hatches -------------------------------------------
# Leave both unset in normal/deployed use.

# Points the browser straight at an engine, bypassing the /api/engine proxy
# entirely. Only for local dev against an engine with no auth configured -
# never set this in a deployment that has KALOS_ENGINE_TOKEN configured, since
# it routes around the proxy that keeps that token off the client.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8050

# Set to "true" to preview demo/mock data on boards with no live engine data.
# NEXT_PUBLIC_DEMO_MODE=true
